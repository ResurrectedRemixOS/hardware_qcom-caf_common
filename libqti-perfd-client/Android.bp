soong_namespace {
}

soong_config_module_type {
    name: "qti_perfd_client_cc_library_shared",
    module_type: "cc_library_shared",
    config_namespace: "qti_perfd",
    bool_variables: ["use_stock_client"],
    properties: ["enabled"],
}

qti_perfd_client_cc_library_shared {
    name: "libqti-perfd-client",
    srcs: ["client.c"],
    shared_libs: [
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    vendor: true,
    // Dodge installs the stock client under the same file name.
    soong_config_variables: {
        use_stock_client: {
            enabled: false,
        },
    },
}
